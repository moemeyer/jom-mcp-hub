{
  "id": "justice-nexus-mcp",
  "name": "Justice Nexus",
  "transport": "streamable-http",
  "status": "development",
  "description": "Legal research, public records, open meetings, procurement, judgments and liens MCP server.",
  "access_required": true,
  "auth": ["bearer", "oauth2_pkce"],
  "oauth2_pkce": true,
  "credentials": {
    "source": "GCP Secret Manager",
    "path": "pestpro/integrations/justice-nexus",
    "env_override": ["MCP_API_KEY", "JUSTICE_NEXUS_MCP_API_KEY"]
  },
  "tools": [
    "generate_public_records_request",
    "search_open_meetings",
    "search_procurement",
    "search_judgments_and_liens"
  ]
}